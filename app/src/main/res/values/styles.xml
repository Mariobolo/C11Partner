<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 应用主题 -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/teal_200</item>
    </style>

    <!-- 无ActionBar的主题 -->
    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- 自定义对话框样式 -->
    <style name="BottomDialogStyle" parent="Theme.AppCompat.Light.Dialog">
        <!-- 去除边框 -->
        <item name="android:windowFrame">@null</item>
        <!-- 是否浮现在activity之上 -->
        <item name="android:windowIsFloating">true</item>
        <!-- 半透明 -->
        <item name="android:windowIsTranslucent">true</item>
        <!-- 无标题 -->
        <item name="android:windowNoTitle">true</item>
        <!-- 背景透明 -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- 模糊 -->
        <item name="android:backgroundDimEnabled">true</item>
        <!-- 遮罩层 -->
        <item name="android:backgroundDimAmount">0.5</item>
        <!-- 设置窗口宽度为屏幕宽度 -->
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <!-- 设置窗口从底部弹出 -->
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
    
    <!-- 对话框动画样式 -->
    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
    
    <!-- 带圆点的进度条样式 -->
    <style name="CustomProgressBar" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:thumb">@drawable/progress_thumb</item>
        <item name="android:progressDrawable">@drawable/progress_bar_background</item>
        <item name="android:minHeight">4dp</item>
        <item name="android:maxHeight">4dp</item>
    </style>
    
    <!-- 美化的SeekBar样式 -->
    <style name="CustomSeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:thumb">@drawable/seekbar_thumb_selector</item>
        <item name="android:progressDrawable">@drawable/progress_bar_horizontal</item>
        <item name="android:minHeight">6dp</item>
        <item name="android:maxHeight">6dp</item>
        <item name="android:thumbOffset">8dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    
    <!-- 基础文字阴影样式 -->
    <style name="TextShadow">
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">2</item>
    </style>
    
    <!-- 文字阴影样式 - 标题 -->
    <style name="TextShadow.Title">
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">4</item>
    </style>
    
    <!-- 文字阴影样式 - 副标题 -->
    <style name="TextShadow.Subtitle">
        <item name="android:shadowColor">#60000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">2</item>
    </style>
    
    <!-- 文字阴影样式 - 发光效果 -->
    <style name="TextShadow.Glow">
        <item name="android:shadowColor">#402196F3</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:shadowRadius">8</item>
    </style>
    
    <!-- 现代化对话框样式 -->
    <style name="ModernDialogStyle" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/dialog_background_modern</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowAnimationStyle">@style/DialogAnimation</item>
    </style>
    
    <!-- 现代化按钮样式 -->
    <style name="ModernButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_modern_selector</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">@dimen/text_base</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/button_height_lg</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:paddingLeft">@dimen/spacing_6</item>
        <item name="android:paddingRight">@dimen/spacing_6</item>
        <item name="android:stateListAnimator">@anim/button_state_animator</item>
    </style>
    
    <!-- 卡片样式 -->
    <style name="ModernCard">
        <item name="android:background">@drawable/card_elevation_background</item>
        <item name="android:padding">@dimen/spacing_6</item>
        <item name="android:layout_margin">@dimen/spacing_4</item>
    </style>
    
    <!-- 现代化输入框样式 -->
    <style name="ModernEditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/edittext_modern_background</item>
        <item name="android:textColor">#212121</item>
        <item name="android:textColorHint">#9E9E9E</item>
        <item name="android:textSize">@dimen/text_base</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">@dimen/spacing_4</item>
        <item name="android:paddingRight">@dimen/spacing_4</item>
        <item name="android:paddingTop">@dimen/spacing_3</item>
        <item name="android:paddingBottom">@dimen/spacing_3</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>