<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 车机应用主主题 - 深色科技风格 -->
    <style name="Theme.C11Partner" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 主品牌色 -->
        <item name="colorPrimary">@color/primary_500</item>
        <item name="colorPrimaryVariant">@color/primary_700</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- 次品牌色 -->
        <item name="colorSecondary">@color/secondary_500</item>
        <item name="colorSecondaryVariant">@color/secondary_700</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- 背景色 - 车机深色主题 -->
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        
        <!-- 错误色 -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>
        
        <!-- 状态栏颜色 -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/bg_dark</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/bg_dark</item>
        
        <!-- 亮色状态栏图标 -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        
        <!-- 按钮样式 -->
        <item name="materialButtonStyle">@style/C11PartnerButton</item>
        
        <!-- 卡片样式 -->
        <item name="materialCardViewStyle">@style/C11PartnerCard</item>
        
        <!-- 文本样式 -->
        <item name="textAppearanceHeadline1">@style/C11PartnerTextAppearance.Headline1</item>
        <item name="textAppearanceHeadline2">@style/C11PartnerTextAppearance.Headline2</item>
        <item name="textAppearanceHeadline3">@style/C11PartnerTextAppearance.Headline3</item>
        <item name="textAppearanceHeadline4">@style/C11PartnerTextAppearance.Headline4</item>
        <item name="textAppearanceHeadline5">@style/C11PartnerTextAppearance.Headline5</item>
        <item name="textAppearanceHeadline6">@style/C11PartnerTextAppearance.Headline6</item>
        <item name="textAppearanceSubtitle1">@style/C11PartnerTextAppearance.Subtitle1</item>
        <item name="textAppearanceSubtitle2">@style/C11PartnerTextAppearance.Subtitle2</item>
        <item name="textAppearanceBody1">@style/C11PartnerTextAppearance.Body1</item>
        <item name="textAppearanceBody2">@style/C11PartnerTextAppearance.Body2</item>
        <item name="textAppearanceCaption">@style/C11PartnerTextAppearance.Caption</item>
        <item name="textAppearanceOverline">@style/C11PartnerTextAppearance.Overline</item>
        
        <!-- 水波纹效果颜色 -->
        <item name="android:colorControlHighlight">@color/primary_200</item>
        
        <!-- 过渡动画 -->
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
    </style>
    
    <!-- 按钮样式 -->
    <style name="C11PartnerButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="elevation">@dimen/elevation_sm</item>
        <item name="android:textSize">@dimen/text_base</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <!-- 卡片样式 -->
    <style name="C11PartnerCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_xl</item>
        <item name="cardElevation">@dimen/elevation_md</item>
        <item name="cardBackgroundColor">@color/bg_card</item>
    </style>
    
    <!-- 文本样式 -->
    <style name="C11PartnerTextAppearance">
        <item name="android:fontFamily">sans-serif</item>
    </style>
    
    <style name="C11PartnerTextAppearance.Headline1" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:textSize">@dimen/text_5xl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>
    
    <style name="C11PartnerTextAppearance.Headline2" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:textSize">@dimen/text_4xl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>
    
    <style name="C11PartnerTextAppearance.Headline3" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:textSize">@dimen/text_3xl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    
    <style name="C11PartnerTextAppearance.Headline4" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">@dimen/text_2xl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="C11PartnerTextAppearance.Headline5" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">@dimen/text_xl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="C11PartnerTextAppearance.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="C11PartnerTextAppearance.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_base</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="C11PartnerTextAppearance.Subtitle2" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="C11PartnerTextAppearance.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_base</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="C11PartnerTextAppearance.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    
    <style name="C11PartnerTextAppearance.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    
    <style name="C11PartnerTextAppearance.Overline" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    
    <!-- 夜间主题 -->
    <style name="Theme.C11Partner.Dark" parent="Theme.C11Partner">
        <!-- 深色主题下的额外配置 -->
    </style>
</resources>