<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 聚焦状态 - 深色主题 -->
    <item android:state_focused="true">
        <layer-list>
            <!-- 外发光效果 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#4000FF88" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- 主背景 -->
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1E1E2E" />
                    <corners android:radius="11dp" />
                    <stroke
                        android:width="2dp"
                        android:color="#00FF88" />
                </shape>
            </item>
            <!-- 顶部内高光 -->
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#15FFFFFF"
                        android:centerColor="#00000000"
                        android:endColor="#00000000" />
                    <corners android:radius="11dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 禁用状态 -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#1A1A2E" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#3A3A4E" />
        </shape>
    </item>
    
    <!-- 默认状态 - 深色主题 -->
    <item>
        <layer-list>
            <!-- 阴影 -->
            <item android:left="0.5dp" android:top="1.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#25000000" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- 主背景 -->
            <item android:bottom="1dp" android:right="0.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#252538" />
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#3A3A4E" />
                </shape>
            </item>
            <!-- 顶部内阴影 -->
            <item android:bottom="1dp" android:right="0.5dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#0A000000"
                        android:centerColor="#00000000"
                        android:endColor="#00000000" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>