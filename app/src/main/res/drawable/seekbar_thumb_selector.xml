<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下状态 - 放大并发光 -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- 外发光效果 -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/glow_primary" />
                    <size android:width="32dp" android:height="32dp" />
                </shape>
            </item>
            <!-- 主滑块 -->
            <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
                <shape android:shape="oval">
                    <solid android:color="@color/primary_500" />
                    <stroke android:width="2dp" android:color="@color/white" />
                    <size android:width="24dp" android:height="24dp" />
                </shape>
            </item>
            <!-- 内圈高光 -->
            <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
                <shape android:shape="oval">
                    <solid android:color="@color/white" />
                    <size android:width="12dp" android:height="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 聚焦状态 -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/glow_primary" />
                    <size android:width="28dp" android:height="28dp" />
                </shape>
            </item>
            <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
                <shape android:shape="oval">
                    <solid android:color="@color/primary_500" />
                    <stroke android:width="1.5dp" android:color="@color/white" />
                    <size android:width="22dp" android:height="22dp" />
                </shape>
            </item>
            <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
                <shape android:shape="oval">
                    <solid android:color="@color/white" />
                    <size android:width="10dp" android:height="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 默认状态 -->
    <item>
        <layer-list>
            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="oval">
                    <solid android:color="@color/primary_400" />
                    <stroke android:width="1dp" android:color="@color/white" />
                    <size android:width="20dp" android:height="20dp" />
                </shape>
            </item>
            <item android:top="7dp" android:bottom="7dp" android:left="7dp" android:right="7dp">
                <shape android:shape="oval">
                    <solid android:color="@color/white" />
                    <size android:width="10dp" android:height="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>