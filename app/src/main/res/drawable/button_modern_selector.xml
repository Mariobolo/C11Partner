<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- 阴影 -->
            <item android:left="2dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#40000000" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- 主背景 -->
            <item android:bottom="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:startColor="#1976D2"
                        android:endColor="#2196F3" />
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#60FFFFFF" />
                </shape>
            </item>
            <!-- 高光 -->
            <item android:bottom="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#40FFFFFF"
                        android:centerColor="#20FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 聚焦状态 -->
    <item android:state_focused="true">
        <layer-list>
            <!-- 外发光 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#402196F3" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- 主背景 -->
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:startColor="#1E88E5"
                        android:endColor="#42A5F5" />
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#BBDEFB" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 禁用状态 -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#BDBDBD" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
    <!-- 默认状态 -->
    <item>
        <layer-list>
            <!-- 阴影 -->
            <item android:left="1dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#30000000" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- 主背景 -->
            <item android:bottom="2dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:startColor="#2196F3"
                        android:endColor="#64B5F6" />
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="0.5dp"
                        android:color="#40FFFFFF" />
                </shape>
            </item>
            <!-- 顶部高光 -->
            <item android:bottom="2dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#30FFFFFF"
                        android:centerColor="#10FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>