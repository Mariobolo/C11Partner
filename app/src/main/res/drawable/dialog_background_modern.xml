<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外发光阴影 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glow_primary" />
            <corners android:radius="@dimen/radius_xl" />
            <padding
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp" />
        </shape>
    </item>
    
    <!-- 主背景 - 半透明毛玻璃效果 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F01E1E1E" />
            <corners android:radius="@dimen/radius_xl" />
        </shape>
    </item>
    
    <!-- 顶部渐变高光 -->
    <item android:height="60dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#1AFFFFFF" />
            <corners
                android:topLeftRadius="@dimen/radius_xl"
                android:topRightRadius="@dimen/radius_xl" />
        </shape>
    </item>
    
    <!-- 边框 -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
            <corners android:radius="@dimen/radius_xl" />
        </shape>
    </item>
</layer-list>