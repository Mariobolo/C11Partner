<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 开启状态+按下状态 -->
    <item android:state_checked="true" android:state_pressed="true">
        <layer-list>
            <!-- 外发光 -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#6000FF88" />
                    <size
                        android:width="@dimen/switch_thumb_size"
                        android:height="@dimen/switch_thumb_size" />
                    <padding
                        android:left="2dp"
                        android:top="2dp"
                        android:right="2dp"
                        android:bottom="2dp" />
                </shape>
            </item>
            <!-- 主滑块 -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#FFFFFFFF" />
                    <size
                        android:width="@dimen/switch_thumb_size"
                        android:height="@dimen/switch_thumb_size" />
                </shape>
            </item>
            <!-- 中心装饰点 -->
            <item
                android:left="6dp"
                android:top="6dp"
                android:right="6dp"
                android:bottom="6dp">
                <shape android:shape="oval">
                    <solid android:color="@color/primary_500" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 开启状态 -->
    <item android:state_checked="true">
        <layer-list>
            <!-- 阴影 -->
            <item android:top="1dp">
                <shape android:shape="oval">
                    <solid android:color="#40000000" />
                    <size
                        android:width="@dimen/switch_thumb_size"
                        android:height="@dimen/switch_thumb_size" />
                </shape>
            </item>
            <!-- 主滑块 -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#FFFFFFFF" />
                    <size
                        android:width="@dimen/switch_thumb_size"
                        android:height="@dimen/switch_thumb_size" />
                </shape>
            </item>
            <!-- 顶部高光 -->
            <item android:bottom="8dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#60FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
            <!-- 中心装饰点 -->
            <item
                android:left="7dp"
                android:top="7dp"
                android:right="7dp"
                android:bottom="7dp">
                <shape android:shape="oval">
                    <solid android:color="@color/primary_400" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 关闭状态+按下状态 -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- 外发光 -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#40FFFFFF" />
                    <size
                        android:width="@dimen/switch_thumb_size"
                        android:height="@dimen/switch_thumb_size" />
                    <padding
                        android:left="2dp"
                        android:top="2dp"
                        android:right="2dp"
                        android:bottom="2dp" />
                </shape>
            </item>
            <!-- 主滑块 -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#FFE0E0E0" />
                    <size
                        android:width="@dimen/switch_thumb_size"
                        android:height="@dimen/switch_thumb_size" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 关闭状态 -->
    <item>
        <layer-list>
            <!-- 阴影 -->
            <item android:top="1dp">
                <shape android:shape="oval">
                    <solid android:color="#60000000" />
                    <size
                        android:width="@dimen/switch_thumb_size"
                        android:height="@dimen/switch_thumb_size" />
                </shape>
            </item>
            <!-- 主滑块 -->
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#FFFFFFFF"
                        android:endColor="#FFE0E0E0" />
                    <size
                        android:width="@dimen/switch_thumb_size"
                        android:height="@dimen/switch_thumb_size" />
                </shape>
            </item>
            <!-- 顶部高光 -->
            <item android:bottom="8dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#80FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>