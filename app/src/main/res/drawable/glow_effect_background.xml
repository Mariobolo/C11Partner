<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外发光效果 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#332196F3"
                android:centerColor="#552196F3"
                android:endColor="#332196F3"
                android:type="linear" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
    <!-- 主体背景 -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
</layer-list>