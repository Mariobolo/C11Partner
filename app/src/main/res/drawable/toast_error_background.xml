<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外发光效果 - 红色 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#40FF5252" />
            <corners android:radius="@dimen/radius_lg" />
            <padding
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp" />
        </shape>
    </item>
    
    <!-- 主背景 -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#E6280D0D" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
    
    <!-- 红色边框 -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#80FF5252" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
    
    <!-- 顶部高光 -->
    <item android:top="1dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#15FF5252"
                android:endColor="#00FF5252" />
            <corners
                android:topLeftRadius="@dimen/radius_lg"
                android:topRightRadius="@dimen/radius_lg" />
        </shape>
    </item>
</layer-list>