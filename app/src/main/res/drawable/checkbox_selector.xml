<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 选中+按下状态 -->
    <item android:state_checked="true" android:state_pressed="true">
        <layer-list>
            <!-- 外发光 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#6000FF88" />
                    <corners android:radius="4dp" />
                    <padding
                        android:left="1dp"
                        android:top="1dp"
                        android:right="1dp"
                        android:bottom="1dp" />
                </shape>
            </item>
            <!-- 主背景 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/primary_500" />
                    <corners android:radius="4dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/primary_300" />
                </shape>
            </item>
            <!-- 对勾图标 -->
            <item
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp">
                <vector xmlns:android="http://schemas.android.com/apk/res/android"
                    android:width="16dp"
                    android:height="16dp"
                    android:viewportWidth="24"
                    android:viewportHeight="24">
                    <path
                        android:fillColor="#FFFFFFFF"
                        android:pathData="M9,16.17L4.83,12l-1.42,1.41L9,19 21,7l-1.41,-1.41L9,16.17z"/>
                </vector>
            </item>
        </layer-list>
    </item>
    
    <!-- 选中状态 -->
    <item android:state_checked="true">
        <layer-list>
            <!-- 阴影 -->
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#40000000" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <!-- 主背景渐变 -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="@color/primary_400"
                        android:endColor="@color/primary_600" />
                    <corners android:radius="4dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/primary_300" />
                </shape>
            </item>
            <!-- 顶部高光 -->
            <item android:bottom="10dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#40FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <!-- 对勾图标 -->
            <item
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp">
                <vector xmlns:android="http://schemas.android.com/apk/res/android"
                    android:width="16dp"
                    android:height="16dp"
                    android:viewportWidth="24"
                    android:viewportHeight="24">
                    <path
                        android:fillColor="#FFFFFFFF"
                        android:pathData="M9,16.17L4.83,12l-1.42,1.41L9,19 21,7l-1.41,-1.41L9,16.17z"/>
                </vector>
            </item>
        </layer-list>
    </item>
    
    <!-- 未选中+按下状态 -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- 背景 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/gray_500" />
                    <corners android:radius="4dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/gray_400" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 未选中状态 -->
    <item>
        <layer-list>
            <!-- 阴影 -->
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#30000000" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <!-- 主背景 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/gray_700" />
                    <corners android:radius="4dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/gray_500" />
                </shape>
            </item>
            <!-- 内阴影 -->
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#20000000"
                        android:endColor="#00000000" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>