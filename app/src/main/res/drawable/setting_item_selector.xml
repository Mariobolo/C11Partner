<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/primary_300">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/bg_surface" />
                    <corners android:radius="@dimen/radius_md" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/bg_card" />
                    <corners android:radius="@dimen/radius_md" />
                    <stroke
                        android:width="@dimen/border_normal"
                        android:color="@color/primary_500" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/bg_card" />
                    <corners android:radius="@dimen/radius_md" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>