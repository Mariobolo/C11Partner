<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外发光效果 - 绿色 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#4000FF88" />
            <corners android:radius="@dimen/radius_lg" />
            <padding
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp" />
        </shape>
    </item>
    
    <!-- 主背景 -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#E60D2818" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
    
    <!-- 绿色边框 -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#8000FF88" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
    
    <!-- 顶部高光 -->
    <item android:top="1dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1500FF88"
                android:endColor="#0000FF88" />
            <corners
                android:topLeftRadius="@dimen/radius_lg"
                android:topRightRadius="@dimen/radius_lg" />
        </shape>
    </item>
</layer-list>