<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 最底层 - 深色阴影 -->
    <item
        android:left="2dp"
        android:top="4dp"
        android:right="2dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    
    <!-- 中间层 - 中等阴影 -->
    <item
        android:left="1dp"
        android:top="2dp"
        android:right="1dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#30000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    
    <!-- 顶层 - 卡片主体 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
        </shape>
    </item>
    
    <!-- 顶部高光 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1AFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    
</layer-list>
